default_platform(:ios)

require "rbconfig"
require "shellwords"
require "tempfile"

APP_IDENTIFIER = "com.nguyenduc.fireGuard"
TEAM_ID = "Q236Z72BGN"
APP_ARTIFACT_NAME = "Fire-Guard"
REPOSITORY_ROOT = ENV["GITHUB_WORKSPACE"].to_s.strip.empty? ?
  File.expand_path("../..", __dir__) :
  File.expand_path(ENV.fetch("GITHUB_WORKSPACE"))
IOS_BUILD_ROOT = File.join(REPOSITORY_ROOT, "build", "ios")
IOS_ARCHIVE_PATH = File.join(IOS_BUILD_ROOT, "archive", "Runner.xcarchive")
IOS_IPA_OUTPUT_DIRECTORY = File.join(IOS_BUILD_ROOT, "ipa")

def bundle_command
  ENV["BUNDLE_BIN"] || File.join(File.dirname(RbConfig.ruby), "bundle")
end

def pubspec_version
  pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
  version_line = File.readlines(pubspec_path).find { |line| line.match?(/\Aversion:/) }
  match = version_line&.match(/\Aversion:\s*([^\s+#]+)(?:\+([^\s#]+))?/)

  UI.user_error!("Missing or invalid version in #{pubspec_path}") unless match

  {
    name: match[1],
    number: match[2] || "1"
  }
end

def flutter_command
  return ENV["FLUTTER_BIN"] unless ENV["FLUTTER_BIN"].to_s.strip.empty?

  fvm = `command -v fvm`.strip
  return "#{fvm} flutter" unless fvm.empty?

  generated_config = File.expand_path("../Flutter/Generated.xcconfig", __dir__)
  if File.exist?(generated_config)
    flutter_root = File.readlines(generated_config).find { |line| line.start_with?("FLUTTER_ROOT=") }&.split("=", 2)&.last&.strip
    flutter_bin = File.join(flutter_root, "bin", "flutter") if flutter_root
    return flutter_bin if flutter_bin && File.executable?(flutter_bin)
  end

  "flutter"
end

def app_store_connect_key_path
  ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"].to_s.strip
end

def ci_provisioning_profile_name
  ENV["IOS_PROVISIONING_PROFILE_NAME"].to_s.strip
end

def match_provisioning_profile_name!
  profiles = Actions.lane_context[
    SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING
  ]

  unless profiles.is_a?(Hash)
    UI.user_error!("Fastlane Match did not return provisioning profile mapping.")
  end

  profile_name = profiles[APP_IDENTIFIER].to_s.strip
  if profile_name.empty?
    UI.user_error!("Match did not provide an App Store profile for #{APP_IDENTIFIER}.")
  end

  profile_name
end

def plist_value(plist_path, key)
  sh(
    "/usr/libexec/PlistBuddy -c #{Shellwords.escape("Print :#{key}")} " \
    "#{Shellwords.escape(plist_path)} 2>/dev/null || true"
  ).strip
end

def installed_match_profile_path!(profile_name)
  profiles_directory = FastlaneCore::ProvisioningProfile.profiles_path
  profile_path = Dir.glob(File.join(profiles_directory, "*.mobileprovision")).find do |candidate|
    FastlaneCore::ProvisioningProfile.name(candidate) == profile_name
  end

  unless profile_path
    UI.user_error!("Match-installed provisioning profile #{profile_name.inspect} was not found.")
  end

  profile_path
end

def validate_match_profile!(profile_name)
  profile_path = installed_match_profile_path!(profile_name)
  profile = FastlaneCore::ProvisioningProfile.parse(profile_path)
  team_id = Array(profile["TeamIdentifier"]).first
  entitlements = profile.fetch("Entitlements", {})
  application_identifier = entitlements["application-identifier"]
  aps_environment = entitlements["aps-environment"]
  expected_application_identifier = "#{TEAM_ID}.#{APP_IDENTIFIER}"

  if team_id != TEAM_ID
    UI.user_error!("Match profile team id mismatch: expected #{TEAM_ID}, got #{team_id.inspect}.")
  end

  if application_identifier != expected_application_identifier
    UI.user_error!(
      "Match profile application identifier mismatch: expected " \
      "#{expected_application_identifier}, got #{application_identifier.inspect}."
    )
  end

  if aps_environment != "production"
    UI.user_error!(
      "Match profile aps-environment must be production, got #{aps_environment.inspect}."
    )
  end
end

def build_export_options
  options = {
    method: "app-store",
    teamID: TEAM_ID,
    uploadSymbols: true,
    manageAppVersionAndBuildNumber: false
  }

  profile_name = ci_provisioning_profile_name
  if profile_name.empty?
    options[:signingStyle] = "automatic"
  else
    options[:signingStyle] = "manual"
    options[:provisioningProfiles] = {
      APP_IDENTIFIER => profile_name
    }
  end

  options
end

def configure_ci_code_signing
  profile_name = ci_provisioning_profile_name
  return if profile_name.empty?

  update_code_signing_settings(
    path: "Runner.xcodeproj",
    use_automatic_signing: false,
    team_id: TEAM_ID,
    targets: ["Runner"],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    profile_name: profile_name
  )
end

def archive_app_path
  File.join(IOS_ARCHIVE_PATH, "Products", "Applications", "Runner.app")
end

def validate_archive_version!(version)
  archive_info_plist = File.join(archive_app_path, "Info.plist")
  unless File.file?(archive_info_plist)
    UI.user_error!("Built archive app Info.plist was not found at #{archive_info_plist}.")
  end

  actual_version = plist_value(archive_info_plist, "CFBundleShortVersionString")
  actual_build = plist_value(archive_info_plist, "CFBundleVersion")

  return if actual_version == version[:name] && actual_build == version[:number]

  UI.user_error!(
    "Archive version validation failed. Expected version #{version[:name]}, " \
    "actual version #{actual_version.inspect}. Expected build number #{version[:number]}, " \
    "actual build number #{actual_build.inspect}."
  )
end

def validate_archive_push_entitlement!
  app_path = archive_app_path
  unless File.directory?(app_path)
    UI.user_error!("Built archive app was not found at #{app_path}.")
  end

  Tempfile.create(["runner-entitlements", ".plist"]) do |entitlements_plist|
    sh(
      "/usr/bin/codesign -d --entitlements :- #{Shellwords.escape(app_path)} > " \
      "#{Shellwords.escape(entitlements_plist.path)} 2>/dev/null"
    )
    aps_environment = plist_value(entitlements_plist.path, "aps-environment")

    unless aps_environment == "production"
      UI.user_error!(
        "Archived Runner.app aps-environment must be production, got #{aps_environment.inspect}."
      )
    end
  end
end

platform :ios do
  before_all do
    ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] ||= "120"
    ENV["FASTLANE_XCODEBUILD_SETTINGS_RETRIES"] ||= "5"
    rubyopt = ENV["RUBYOPT"].to_s.split
    ENV["RUBYOPT"] = (["-rlogger"] + rubyopt).uniq.join(" ")
  end

  desc "Build signed iOS IPA locally"
  lane :build do
    version = pubspec_version

    Dir.chdir("..") do
      sh("#{flutter_command} pub get")
    end

    sh("#{bundle_command} exec pod install")
    configure_ci_code_signing

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_options: build_export_options,
      archive_path: IOS_ARCHIVE_PATH,
      output_directory: IOS_IPA_OUTPUT_DIRECTORY,
      output_name: "#{APP_ARTIFACT_NAME}-#{version[:name]}-#{version[:number]}.ipa",
      clean: true,
      include_symbols: true,
      skip_profile_detection: true
    )
  end

  desc "Build & upload iOS app to TestFlight"
  lane :beta do
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )

    match(
      type: "appstore",
      platform: "ios",
      app_identifier: APP_IDENTIFIER,
      readonly: true,
      api_key: api_key
    )

    profile_name = match_provisioning_profile_name!
    ENV["IOS_PROVISIONING_PROFILE_NAME"] = profile_name
    validate_match_profile!(profile_name)

    build
    validate_archive_version!(pubspec_version)
    validate_archive_push_entitlement!

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Validate read-only iOS release access and profile configuration"
  lane :validate_release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: ENV.fetch("APP_STORE_CONNECT_API_KEY_KEY_FILEPATH")
    )

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    unless app
      UI.user_error!("App Store Connect API key cannot access #{APP_IDENTIFIER}.")
    end

    match(
      type: "appstore",
      platform: "ios",
      app_identifier: APP_IDENTIFIER,
      readonly: true,
      api_key: api_key
    )

    validate_match_profile!(match_provisioning_profile_name!)
    UI.success("Read-only iOS release validation passed for #{APP_IDENTIFIER}.")
  end
end
